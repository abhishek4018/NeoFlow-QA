{
  "name": "neoflow-qa",
  "version": "3.0.0",
  "description": "Agentic BDD Automation Engine combining Serenity/JS, Cucumber, Playwright, and AI Workflows",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf \"target/*\" && mkdirp target",
    "test": "failsafe clean test:execute",
    "test:execute": "cucumber-js",
    "test:smoke": "npm run clean && cucumber-js --tags \"@smoke\"",
    "test:regression": "npm run clean && cucumber-js --tags \"@regression\"",
    "test:local": "cucumber-js features/pariksha_pure_ui.feature features/codegen/*.feature",
    "test:negative": "npm run clean && cucumber-js --tags \"@negative\"",
    "test:debug": "HEADLESS=false PWDEBUG=1 BASE_URL=https://uat.quickexamcreator.com npm run test:negative",
    "test:report": "npm start",
    "start": "mkdirp target/site/serenity && npx http-server -p 8080 target/site/serenity -s -o",
    "lint": "eslint --ext ts --config .eslintrc.js .",
    "lint:fix": "npm run lint -- --fix",
    "codegen": "playwright codegen",
    "codegen:library": "mkdirp generated/codegen && playwright codegen --target javascript -o generated/codegen/recording.ts",
    "codegen:library:preview": "playwright codegen --target javascript",
    "codegen:playwright-test": "playwright codegen --target playwright-test",
    "care:explore": "ts-node --transpile-only src/care/daemon.ts --explore",
    "care:heal": "ts-node --transpile-only src/care/visual-healer.ts",
    "care:run": "ts-node --transpile-only src/care/daemon.ts --once",
    "care:daemon": "ts-node --transpile-only src/care/daemon.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek4018/NeoFlow-QA.git"
  },
  "keywords": [
    "neoflow",
    "serenity-js",
    "bdd",
    "cucumber",
    "testing",
    "playwright",
    "agentic-ai",
    "playwright-test"
  ],
  "author": "Abhishek Kumar",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/abhishek4018/NeoFlow-QA/issues"
  },
  "homepage": "https://serenity-js.org",
  "engines": {
    "node": "^18.12 || ^20 || ^22"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.62.1",
    "@serenity-js/assertions": "^3.46.0",
    "@serenity-js/console-reporter": "^3.46.0",
    "@serenity-js/core": "^3.46.0",
    "@serenity-js/cucumber": "^3.46.0",
    "@serenity-js/html-reporter": "^3.46.0",
    "@serenity-js/playwright": "^3.46.0",
    "@serenity-js/rest": "^3.46.0",
    "@serenity-js/serenity-bdd": "^3.46.0",
    "@serenity-js/web": "^3.46.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^52.0.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "glob": "^13.0.6",
    "http-server": "^14.1.1",
    "is-ci": "^4.1.0",
    "mkdirp": "^3.0.1",
    "npm-failsafe": "^1.3.0",
    "playwright": "^1.62.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "better-sqlite3": "^13.0.3",
    "js-yaml": "^5.3.0",
    "openai": "^7.10.0"
  }
}
