{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["es2019", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": true,
    "types": ["node"]
  },

  "include": [
     "features/**/*.ts",
     "test/**/*.ts",
     "step-definitions/**/*.ts",
     "support/**/*.ts",
     "codegen/**/*.ts",
     "playwright.codegen.config.ts"
  ],

  "exclude": [
    "node_modules"
  ]
}
